{
  "name": "grokbot-notch",
  "version": "1.0.0",
  "description": "Notch companion for Desktop Grok Bot on macOS, and a top-of-screen overlay on Windows, with flat Motion Lab characters and live xAI Realtime Voice Mode",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuelcastrobarinas/grokbot-notch.git"
  },
  "keywords": [
    "grok",
    "grok-bot",
    "xai",
    "macos",
    "windows",
    "notch",
    "voice-mode",
    "realtime"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:mac": "bash scripts/setup.sh",
    "install:app": "bash scripts/setup.sh --install",
    "start": "node scripts/start.mjs",
    "start:mac": "bash scripts/launch.sh",
    "server": "node server.mjs",
    "build:mac": "bash scripts/build-mac-app.sh"
  },
  "dependencies": {
    "electron": "^33.4.11"
  }
}
